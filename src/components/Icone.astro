---
/**
 * Icones de l'interface, reprises telles quelles de Figma.
 *
 * Les SVG exportes par Figma portent une couleur figee (#F2F1FA, #A6A3C4…),
 * c'est-a-dire la valeur du MODE SOMBRE : telles quelles, ces icones seraient
 * invisibles en theme clair. Les traces sont donc repris au pixel pres, mais
 * la couleur passe en `currentColor` pour suivre le texte environnant.
 * Les fichiers d'origine sont conserves dans src/assets/icons/ pour reference.
 *
 * Les icones sont decoratives : le libelle vient du texte ou de l'aria-label
 * du bouton qui les contient.
 */
interface Props {
  nom:
    | 'soleil-18'
    | 'soleil-16'
    | 'lune-18'
    | 'lune-16'
    | 'burger'
    | 'telechargement'
    | 'fleche-haut';
  class?: string;
}

const { nom, class: className } = Astro.props;
---

{
  nom === 'soleil-18' && (
    <svg class={className} width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
      <path d="M9 12C10.6569 12 12 10.6569 12 9C12 7.34315 10.6569 6 9 6C7.34315 6 6 7.34315 6 9C6 10.6569 7.34315 12 9 12Z" stroke="currentColor" stroke-width="1.35" />
      <path d="M9 1.5V3M9 15V16.5M3.675 3.675L4.725 4.725M13.275 13.275L14.325 14.325M1.5 9H3M15 9H16.5M3.675 14.325L4.725 13.275M13.275 4.725L14.325 3.675" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
    </svg>
  )
}
{
  nom === 'soleil-16' && (
    <svg class={className} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 10.6667C9.47276 10.6667 10.6667 9.47276 10.6667 8C10.6667 6.52724 9.47276 5.33333 8 5.33333C6.52724 5.33333 5.33333 6.52724 5.33333 8C5.33333 9.47276 6.52724 10.6667 8 10.6667Z" stroke="currentColor" stroke-width="1.33333" />
      <path d="M8 1.33333V2.66667M8 13.3333V14.6667M3.26667 3.26667L4.2 4.2M11.8 11.8L12.7333 12.7333M1.33333 8H2.66667M13.3333 8H14.6667M3.26667 12.7333L4.2 11.8M11.8 4.2L12.7333 3.26667" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" />
    </svg>
  )
}
{
  nom === 'lune-18' && (
    <svg class={className} width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
      <path d="M15 10.875C13.8983 11.3458 12.6809 11.4759 11.5046 11.2487C10.3283 11.0215 9.24691 10.4474 8.39976 9.60024C7.55261 8.75309 6.97847 7.67172 6.75127 6.4954C6.52408 5.31909 6.65425 4.10169 7.125 3C6.22285 3.38549 5.42898 3.98632 4.81295 4.74986C4.19692 5.51339 3.77751 6.41634 3.59147 7.3796C3.40543 8.34286 3.45842 9.33704 3.74582 10.2751C4.03322 11.2131 4.54624 12.0663 5.23996 12.76C5.93367 13.4538 6.78691 13.9668 7.72493 14.2542C8.66296 14.5416 9.65714 14.5946 10.6204 14.4085C11.5837 14.2225 12.4866 13.8031 13.2501 13.187C14.0137 12.571 14.6145 11.7772 15 10.875Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
    </svg>
  )
}
{
  nom === 'lune-16' && (
    <svg class={className} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M13.3333 9.66667C12.3541 10.0851 11.2719 10.2008 10.2263 9.99887C9.18069 9.79692 8.21948 9.28657 7.46646 8.53354C6.71343 7.78052 6.20308 6.81931 6.00113 5.77369C5.79918 4.72808 5.91488 3.64595 6.33333 2.66667C5.53142 3.00933 4.82576 3.5434 4.27818 4.22209C3.73059 4.90079 3.35779 5.70341 3.19242 6.55964C3.02704 7.41587 3.07415 8.29959 3.32962 9.13339C3.58508 9.96719 4.0411 10.7256 4.65774 11.3423C5.27438 11.9589 6.03281 12.4149 6.86661 12.6704C7.70041 12.9258 8.58413 12.973 9.44036 12.8076C10.2966 12.6422 11.0992 12.2694 11.7779 11.7218C12.4566 11.1742 12.9907 10.4686 13.3333 9.66667Z" stroke="currentColor" stroke-width="1.33333" stroke-linejoin="round" />
    </svg>
  )
}
{
  nom === 'burger' && (
    <svg class={className} width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true" focusable="false">
      <path d="M1 1H17M1 7H17M1 13H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )
}
{
  nom === 'telechargement' && (
    <svg class={className} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 2V10M4.8 6.8L8 10L11.2 6.8M2.5 13.5H13.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  nom === 'fleche-haut' && (
    <svg class={className} width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
      <path d="M6 10.5V1.5M10 5.5L6 1.5L2 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}

<style>
  svg {
    display: block;
    flex-shrink: 0;
  }
</style>
