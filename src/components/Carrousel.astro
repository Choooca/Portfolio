---
// Carrousel de la page projet — Figma « Carousel » (2006:698) et
// « Thumbnails » (2006:710).
//
// Desktop : carte centrale large, voisines à 35 %, flèches et vignettes.
// Mobile : défilement au doigt et points.
// Clavier : flèches gauche/droite. Changer de média met en pause la vidéo.
import Media from './Media.astro';
import Icone from './Icone.astro';
import { pick, type Locale } from '../i18n';
import type { CollectionEntry } from 'astro:content';

type Medias = CollectionEntry<'projets'>['data']['medias'];

interface Props {
  medias: Medias;
  titre: string;
  locale?: Locale;
}

const { medias, titre, locale = 'fr' } = Astro.props;

const diapos = medias.map((media, i) => ({
  index: i,
  type: media.type,
  src: media.type === 'image' ? media.src : media.poster,
  video: media.type === 'video' ? media.src : undefined,
  legende: pick(media.legende, media.legende_en, locale),
}));
---

<section class="carrousel" aria-roledescription="carrousel" aria-label={titre} data-carrousel>
  <div class="piste" data-piste>
    {
      diapos.map((diapo) => (
        <div
          class="diapo"
          role="group"
          aria-roledescription="diapositive"
          aria-label={`${diapo.index + 1} sur ${diapos.length} — ${diapo.legende}`}
          data-diapo={diapo.index}
        >
          <Media
            type={diapo.type}
            src={diapo.src}
            video={diapo.video}
            alt={diapo.legende}
            prioritaire={diapo.index === 0}
            sizes="(max-width: 1023px) 100vw, 1280px"
            class="diapo__media"
          />
        </div>
      ))
    }
  </div>

  {
    diapos.length > 1 && (
      <>
        <button type="button" class="fleche fleche--prec" data-carrousel-prec>
          <Icone nom="chevron-gauche" />
          <span class="visually-hidden">Média précédent</span>
        </button>
        <button type="button" class="fleche fleche--suiv" data-carrousel-suiv>
          <Icone nom="chevron-droit" />
          <span class="visually-hidden">Média suivant</span>
        </button>

        <p class="compteur" aria-live="polite">
          <span data-carrousel-courant>1</span> / {diapos.length}
        </p>
      </>
    )
  }
</section>

{
  diapos.length > 1 && (
    <>
      {/* Vignettes : desktop. */}
      <div class="vignettes" role="tablist" aria-label="Choisir un média">
        {diapos.map((diapo) => (
          <button
            type="button"
            class="vignette"
            role="tab"
            aria-selected={diapo.index === 0 ? 'true' : 'false'}
            aria-controls={`diapo-${diapo.index}`}
            data-vignette={diapo.index}
          >
            <Media
              type="image"
              src={diapo.src}
              alt={diapo.legende}
              widths={[160, 320]}
              sizes="160px"
              class="vignette__media"
            />
            {diapo.type === 'video' && (
              <span class="vignette__play" aria-hidden="true">
                <Icone nom="play" />
              </span>
            )}
            <span class="visually-hidden">
              Média {diapo.index + 1} — {diapo.legende}
            </span>
          </button>
        ))}
      </div>

      {/* Points : mobile. De vrais boutons — les flèches et les vignettes
          sont masquées à cette largeur, sans eux il ne resterait que le
          glissement au doigt, inutilisable à la souris ou au clavier. */}
      <div class="points" role="tablist" aria-label="Choisir un média">
        {diapos.map((diapo) => (
          <button
            type="button"
            class="point"
            role="tab"
            aria-selected={diapo.index === 0 ? 'true' : 'false'}
            data-point={diapo.index}
          >
            <span class="visually-hidden">
              Média {diapo.index + 1} sur {diapos.length}
            </span>
          </button>
        ))}
      </div>
    </>
  )
}

<p class="legende" data-carrousel-legende>{diapos[0]?.legende}</p>

<style>
  /* ====================================================================
     Mobile : une diapo par écran, défilement au doigt.
     ==================================================================== */
  .carrousel {
    position: relative;
  }

  .piste {
    display: flex;
    gap: 12px;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .piste::-webkit-scrollbar {
    display: none;
  }

  .diapo {
    flex: 0 0 100%;
    scroll-snap-align: center;
  }

  .diapo :global(.diapo__media) {
    aspect-ratio: 16 / 9;
    border-radius: 16px;
  }

  /* Flèches et compteur : desktop seulement. */
  .fleche,
  .compteur,
  .vignettes {
    display: none;
  }

  .points {
    display: flex;
    gap: 4px;
    justify-content: center;
    padding-block-start: 8px;
  }

  /* Cible tactile de 24px, pastille visible de 8px au centre. */
  .point {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  .point::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: var(--text-subtle);
    opacity: 0.4;
    transition: opacity 140ms ease, background-color 140ms ease, width 140ms ease;
  }

  .point[data-actif]::before {
    width: 20px;
    background-color: var(--accent-fill);
    opacity: 1;
  }

  .legende {
    padding: 12px var(--gutter) 0;
    font-size: 13px;
    color: var(--text-subtle);
    text-align: center;
  }

  /* ====================================================================
     Desktop : carte centrale large, voisines estompées.
     ==================================================================== */
  @media (min-width: 1024px) {
    .piste {
      gap: 24px;
      padding-inline: calc(50% - 640px);
      scroll-snap-type: x mandatory;
    }

    /* Les clones sont des copies : ils portent la même classe `.diapo`. */
    .diapo {
      flex: 0 0 1280px;
      opacity: 0.35;
      /* Les diapos latérales amènent à elles au clic. */
      cursor: pointer;
      transition: opacity 240ms ease;
    }

    .diapo[data-actif] {
      opacity: 1;
      cursor: default;
    }

    .diapo:not([data-actif]):hover {
      opacity: 0.55;
    }

    .diapo :global(.diapo__media) {
      border-radius: 24px;
    }

    .fleche {
      position: absolute;
      top: 50%;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      border: 1px solid var(--border-default);
      border-radius: 28px;
      background-color: var(--surface-raised);
      color: var(--text-primary);
      box-shadow: var(--ombre-flottante);
      transform: translateY(-50%);
    }

    .fleche--prec {
      left: calc(50% - 668px);
    }

    .fleche--suiv {
      right: calc(50% - 668px);
    }

    .fleche:hover {
      background-color: var(--surface-default);
    }

    .compteur {
      position: absolute;
      right: calc(50% - 625px);
      bottom: 24px;
      z-index: 2;
      display: block;
      padding: 6px 14px;
      border-radius: 999px;
      background-color: rgb(0 0 0 / 0.6);
      color: #f2f1fa;
      font-weight: var(--fw-medium);
      font-size: 14px;
    }

    .vignettes {
      display: flex;
      gap: 12px;
      justify-content: center;
      padding-block-start: 24px;
    }

    .vignette {
      position: relative;
      width: 160px;
      height: 90px;
      border: 2px solid transparent;
      border-radius: 10px;
      opacity: 0.6;
      transition: opacity 140ms ease;
    }

    .vignette :global(.vignette__media) {
      width: 100%;
      height: 100%;
      border-radius: 8px;
    }

    .vignette[aria-selected='true'] {
      border-color: var(--accent-fill);
      opacity: 1;
    }

    .vignette:hover {
      opacity: 1;
    }

    .vignette__play {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
    }

    .points {
      display: none;
    }

    .legende {
      padding-block-start: 16px;
      font-size: 14px;
    }
  }
</style>

<script>
  import { creerCarrousel } from '../lib/carrousel';

  const piste = document.querySelector<HTMLElement>('[data-piste]');

  if (piste) {
    const vignettes = Array.from(
      document.querySelectorAll<HTMLElement>('[data-vignette]'),
    );
    const points = Array.from(document.querySelectorAll<HTMLElement>('[data-point]'));
    const champCourant = document.querySelector<HTMLElement>('[data-carrousel-courant]');
    const champLegende = document.querySelector<HTMLElement>('[data-carrousel-legende]');
    const legendes = Array.from(
      piste.querySelectorAll<HTMLElement>('[data-diapo]'),
    ).map((d) => d.getAttribute('aria-label')?.split(' — ').slice(1).join(' — ') ?? '');

    const carrousel = creerCarrousel({
      piste,
      // Les vignettes et les points sont hors du <section> : ils doivent
      // eux aussi reagir aux fleches du clavier.
      zonesClavier: [
        document.querySelector('.vignettes'),
        document.querySelector('.points'),
      ],
      surChangement(index) {
        vignettes.forEach((v, i) =>
          v.setAttribute('aria-selected', i === index ? 'true' : 'false'),
        );
        points.forEach((p, i) => {
          p.toggleAttribute('data-actif', i === index);
          p.setAttribute('aria-selected', i === index ? 'true' : 'false');
        });
        if (champCourant) champCourant.textContent = String(index + 1);
        if (champLegende) champLegende.textContent = legendes[index] ?? '';
      },
    });

    if (carrousel) {
      document
        .querySelector('[data-carrousel-prec]')
        ?.addEventListener('click', () => carrousel.decaler(-1));
      document
        .querySelector('[data-carrousel-suiv]')
        ?.addEventListener('click', () => carrousel.decaler(1));

      vignettes.forEach((v, i) => v.addEventListener('click', () => carrousel.aller(i)));
      points.forEach((p, i) => p.addEventListener('click', () => carrousel.aller(i)));
    }
  }
</script>
