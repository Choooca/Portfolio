---
// Bibliotheque — Figma « Screen / Bibliothèque » (58:5),
// « Filtre actif » (59:353), « Aucun résultat » (2014:3398) et
// « Mobile / Bibliothèque » (2010:1589).
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Filtres, { type Option } from '../components/Filtres.astro';
import Icone from '../components/Icone.astro';
import { SECTIONS, type Section } from '../content.config';
import { GROUPES, type Groupe } from '../lib/filtres';
import { slugifyFiltre } from '../lib/slug';
import { useTranslations, DEFAULT_LOCALE, type TranslationKey } from '../i18n';

const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);

const projets = await getCollection('projets');

function trier(a: (typeof projets)[number], b: (typeof projets)[number]) {
  const oa = a.data.ordre;
  const ob = b.data.ordre;
  if (oa !== undefined && ob !== undefined) return oa - ob;
  if (oa !== undefined) return -1;
  if (ob !== undefined) return 1;
  return a.data.titre.localeCompare(b.data.titre, 'fr');
}

const sections = SECTIONS.map((cle: Section) => ({
  cle,
  titre: t(`bib.section.${cle}` as TranslationKey),
  description: t(`bib.section.${cle}.desc` as TranslationKey),
  projets: projets.filter((p) => p.data.section === cle).sort(trier),
}));

/**
 * Options des menus : chaque valeur porte le nombre total de projets qui
 * l'utilisent. Les valeurs sans aucun projet n'apparaissent pas, comme le
 * demande le document.
 */
function construireOptions(groupe: Groupe): Option[] {
  const compte = new Map<string, { libelle: string; nombre: number }>();

  for (const projet of projets) {
    const valeurs: string[] =
      groupe === 'moteur'
        ? projet.data.moteur
          ? [projet.data.moteur]
          : []
        : groupe === 'domaine'
          ? [...projet.data.domaine]
          : [...projet.data.langage];

    for (const libelle of valeurs) {
      const valeur = slugifyFiltre(libelle);
      const existant = compte.get(valeur);
      if (existant) existant.nombre += 1;
      else compte.set(valeur, { libelle, nombre: 1 });
    }
  }

  return [...compte.entries()]
    .map(([valeur, { libelle, nombre }]) => ({ valeur, libelle, nombre }))
    .sort((a, b) => a.libelle.localeCompare(b.libelle, 'fr'));
}

const options = Object.fromEntries(
  GROUPES.map((g) => [g, construireOptions(g)]),
) as Record<Groupe, Option[]>;
---

<BaseLayout titre={t('bib.titre')} description={t('bib.sousTitre')} locale={locale}>
  <header class="entete wrapper">
    <h1>{t('bib.titre')}</h1>
    <p class="sous-titre">{t('bib.sousTitre')}</p>
  </header>

  <Filtres options={options} total={projets.length} locale={locale} />

  <div class="contenu wrapper">
    {
      sections.map((section) => (
        <section
          class="section"
          aria-labelledby={`section-${section.cle}`}
          data-section
        >
          <div class="section__entete">
            <h2 id={`section-${section.cle}`}>{section.titre}</h2>
            <span class="compteur" data-section-compteur>
              {section.projets.length}
            </span>
            <hr class="filet" />
            <p class="description">{section.description}</p>
          </div>

          <ul class="grille" role="list" data-grille>
            {section.projets.map((projet) => (
              <li>
                <ProjectCard projet={projet} locale={locale} />
              </li>
            ))}
          </ul>

        </section>
      ))
    }

    {/* Aucun résultat du tout : remplace les sections.
        Figma « Screen / Bibliothèque — Aucun résultat » (2014:3618).
        `role="status"` : le filtrage se fait sans rechargement, l'apparition
        du message doit donc être annoncée. */}
    <div class="vide" hidden role="status" data-vide-global>
      <span class="vide__icone" aria-hidden="true">
        <Icone nom="loupe-vide" />
      </span>
      <p class="vide__titre">{t('bib.vide.titre')}</p>
      <p class="vide__texte">{t('bib.vide.texte')}</p>
      <div class="vide__actions">
        <button type="button" class="vide__bouton" data-reinitialiser>
          {t('bib.filtres.reinitialiser')}
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---- En-tete de page ---- */
  .entete {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 32px 24px;
  }

  h1 {
    font-weight: var(--fw-semibold);
    font-size: 36px;
    letter-spacing: -0.36px;
    color: var(--text-primary);
  }

  .sous-titre {
    font-weight: var(--fw-light);
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* ---- Sections ---- */
  .contenu {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: 32px 64px;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section__entete {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: center;
  }

  h2 {
    font-weight: var(--fw-semibold);
    font-size: 24px;
    letter-spacing: -0.24px;
    color: var(--text-primary);
  }

  .compteur {
    padding: 3px 9px;
    border: 1px solid var(--border-default);
    border-radius: 999px;
    background-color: var(--surface-raised);
    font-weight: var(--fw-medium);
    font-size: 13px;
    color: var(--text-muted);
  }

  .filet {
    display: none;
    flex: 1;
    height: 1px;
    min-width: 0;
    margin: 0;
    border: none;
    background-color: var(--separator);
  }

  .description {
    flex-basis: 100%;
    font-weight: var(--fw-light);
    font-size: 13px;
    color: var(--text-muted);
  }

  /* ---- Grille ---- */
  .grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin: 0;
  }

  .grille > li {
    display: flex;
  }

  .grille > li > :global(.carte) {
    width: 100%;
  }

  /* Section sans aucun projet (hors filtrage) : pas d'espace vide. */
  .grille:empty {
    display: none;
  }


  /* ---- Aucun résultat ---- */
  .vide {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    padding-block: 48px;
    text-align: center;
  }

  .vide__icone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border: 1px solid var(--border-default);
    border-radius: 36px;
    background-color: var(--surface-default);
    color: var(--text-muted);
  }

  .vide__titre {
    font-weight: var(--fw-semibold);
    font-size: 22px;
    letter-spacing: -0.28px;
    text-wrap: balance;
    color: var(--text-primary);
  }

  .vide__texte {
    font-weight: var(--fw-light);
    font-size: 15px;
    text-wrap: balance;
    color: var(--text-muted);
  }

  .vide__actions {
    padding-block-start: 12px;
  }

  .vide__bouton {
    padding: 14px 22px;
    border-radius: 12px;
    background-color: var(--accent-fill);
    color: var(--accent-on);
    font-weight: var(--fw-semibold);
    font-size: 16px;
  }

  /* ====================================================================
     Tablette : 2 cartes par ligne.
     ==================================================================== */
  @media (min-width: 640px) {
    .grille {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  /* ====================================================================
     Desktop : 4 cartes par ligne, tailles de la maquette 1920.
     ==================================================================== */
  @media (min-width: 1024px) {
    .entete {
      gap: 16px;
      padding-block: 96px 48px;
    }

    h1 {
      font-size: 72px;
      letter-spacing: -1.44px;
    }

    .sous-titre {
      font-size: 22px;
    }

    .contenu {
      gap: 96px;
      padding-block: 72px 140px;
    }

    .section {
      gap: 32px;
    }

    .section__entete {
      flex-wrap: nowrap;
      gap: 16px;
    }

    h2 {
      font-size: 36px;
      letter-spacing: -0.36px;
    }

    .compteur {
      padding: 4px 10px;
      font-size: 14px;
    }

    .filet {
      display: block;
    }

    .description {
      flex-basis: auto;
      font-size: 16px;
      white-space: nowrap;
    }

    .grille {
      grid-template-columns: repeat(4, 1fr);
    }


    .vide {
      padding-block: 96px;
    }

    .vide__titre {
      font-size: 28px;
    }

    .vide__texte {
      font-size: 18px;
    }
  }
</style>
