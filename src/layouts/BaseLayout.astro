---
import '../styles/global.css';
import { absoluteUrl, canonicalUrl } from '../lib/url';
import { DEFAULT_LOCALE, type Locale } from '../i18n';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Importes en `?url` pour que Vite applique le `base` du site et un hash
// de cache : on ne peut pas ecrire le chemin en dur dans le <link>.
import fontRegular from '../assets/fonts/IntelOneMono-Regular.woff2?url';
import fontMedium from '../assets/fonts/IntelOneMono-Medium.woff2?url';

interface Props {
  titre: string;
  description?: string;
  locale?: Locale;
  /** Masque le titre du site devant le titre de la page (utile en accueil). */
  titreSeul?: boolean;
}

const {
  titre,
  description = 'Portfolio de Paul Vincensini, gameplay programmer.',
  locale = DEFAULT_LOCALE,
  titreSeul = false,
} = Astro.props;

const SITE_NAME = 'Paul Vincensini';
const titreComplet = titreSeul ? titre : `${titre} — ${SITE_NAME}`;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={absoluteUrl('/favicon.svg', Astro.site)} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />

    <!-- Les deux graisses presentes sur chaque page, chargees en priorite. -->
    <link rel="preload" href={fontRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontMedium} as="font" type="font/woff2" crossorigin />

    {/*
      Theme applique AVANT le premier rendu, pour eviter le flash.
      `is:inline` empeche Astro de deplacer ou differer ce script.
      Le mode sombre est la reference : sans JavaScript, le site reste en
      sombre, qui est le theme par defaut de tokens.css.
    */}
    <script is:inline>
      (function () {
        var KEY = 'theme';
        var root = document.documentElement;
        var media = window.matchMedia('(prefers-color-scheme: light)');

        function stored() {
          try {
            var v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) {
            return null;
          }
        }

        function apply(theme) {
          root.dataset.theme = theme;
        }

        // Choix memorise d'abord, preference systeme ensuite.
        apply(stored() || (media.matches ? 'light' : 'dark'));

        // Suivre le systeme tant que le visiteur n'a rien choisi.
        media.addEventListener('change', function (event) {
          if (!stored()) apply(event.matches ? 'light' : 'dark');
        });
      })();
    </script>
  </head>

  <body>
    <Nav locale={locale} />
    <main id="contenu">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      /*
        Liens d'ancre internes (« Contact » vers le pied de page, « Retour en
        haut »). Par défaut le navigateur empile une entrée d'historique à
        chaque clic : le bouton Précédent se mettait à rejouer les
        défilements au lieu de revenir à la page précédente. On défile
        nous-mêmes, sans toucher à l'historique ni à l'adresse.
      */
      document.addEventListener('click', (event) => {
        const lien = (event.target as HTMLElement).closest<HTMLAnchorElement>(
          'a[href^="#"]',
        );
        if (!lien || lien.hasAttribute('download')) return;

        const id = lien.getAttribute('href')?.slice(1);
        const cible = id ? document.getElementById(id) : null;
        if (!cible) return;

        event.preventDefault();

        const animations = !window.matchMedia('(prefers-reduced-motion: reduce)')
          .matches;
        cible.scrollIntoView({
          behavior: animations ? 'smooth' : 'auto',
          block: 'start',
        });

        // Le focus doit suivre, sinon la navigation au clavier reste en haut.
        cible.setAttribute('tabindex', '-1');
        cible.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
